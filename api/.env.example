APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=mcvsync_session
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SANCTUM_EXPIRATION=null

FRONTEND_URL=http://localhost:5173
PORTAL_URL=http://localhost:5174

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=superadmin@mcvsync.local
SUPER_ADMIN_PASSWORD=change-me-immediately

# Local/dev only — shared password for the demo accounts DemoStaffSeeder creates.
# DemoStaffSeeder refuses to run outside local/testing regardless of this value.
SEED_USER_PASSWORD=password
SEED_DEMO_ACCOUNTS=false

# Falls back for any item with no expiry_alert_threshold_days of its own.
# Owned by Admin's System Configuration screen once that module exists.
INVENTORY_DEFAULT_EXPIRY_ALERT_THRESHOLD_DAYS=30

BROADCAST_CONNECTION=reverb

# Local dev Reverb server — generate real values per environment, never
# reuse these. `reverb:start` reads the REVERB_* ones directly.
REVERB_APP_ID=change-me
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=*

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
